rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: {uid}
    // Fields: uid, email, displayName, photoURL, role, totalScore, teamId
    
    // Collection: game_state
    // Document ID: current
    // Fields: status, currentQuestionId, startTime, round
    
    // Collection: questions
    // Document ID: {id}
    // Fields: id, text, type, options, correctIndex, mediaUrl, points, duration
    
    // Collection: responses
    // Document ID: {userId}_{questionId}
    // Fields: userId, questionId, selectedIndex, timeTaken, pointsEarned, timestamp, isAudience
    
    // Collection: teams
    // Document ID: {id}
    // Fields: id, name, memberUids, totalScore

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
         (request.auth.token.email == "yashbose35@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'student'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && isValidUser(request.resource.data) && (request.resource.data.role == 'student' || isAdmin());
      allow update: if isAdmin() || (isOwner(uid) && request.resource.data.role == resource.data.role);
    }

    match /game_state/current {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /questions/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /responses/{responseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /teams/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
