rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: {uid}
    // Fields: uid, email, displayName, photoURL, role, totalScore, teamId
    
    // Collection: game_state
    // Document ID: current
    // Fields: status, currentQuestionId, startTime, round
    
    // Collection: questions
    // Document ID: {id}
    // Fields: id, text, type, options, correctIndex, mediaUrl, points, duration
    
    // Collection: responses
    // Document ID: {userId}_{questionId}
    // Fields: userId, questionId, selectedIndex, timeTaken, pointsEarned, timestamp, isAudience
    
    // Collection: teams
    // Document ID: {id}
    // Fields: id, name, memberUids, totalScore

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "yashbose35@gmail.com" || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'student'];
    }

    function isValidResponse(data) {
      return data.keys().hasAll(['userId', 'questionId', 'selectedIndex', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.questionId is string &&
             data.selectedIndex is int &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && isValidUser(incoming()) && (incoming().role == 'student' || isAdmin());
      allow update: if isAdmin() || (isOwner(uid) && incoming().role == existing().role);
      allow delete: if isAdmin();
    }

    match /game_state/current {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /questions/{id} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /responses/{responseId} {
      allow get: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidResponse(incoming());
      allow update, delete: if isAdmin();
    }

    match /teams/{id} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid in existing().memberUids && 
        incoming().diff(existing()).affectedKeys().hasOnly(['totalScore'])
      );
    }
  }
}
